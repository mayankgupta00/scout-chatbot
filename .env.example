# Copy this file to ".env" and put your real key in it.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-key-here

# Required for login to work securely. Make this a long random string —
# you can generate one at random.org or just mash your keyboard for 40+ characters.
JWT_SECRET=change-this-to-a-long-random-string

# Optional: change which port the server runs on
PORT=3000

# Optional — if you want Scout to email your support team automatically
# when it hands off a conversation. Leave blank to skip email; escalations
# are always saved to data/escalations even without this.
SUPPORT_EMAIL=support@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

